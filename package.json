{
  "name": "console.tty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Rust-owned terminal in the browser DevTools console",
  "workspaces": [
    "extension"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test extension/test/*.test.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "test:browser": "node scripts/browser.mjs",
    "test:console": "node scripts/console-rendering.mjs",
    "test:native-browser": "node scripts/native-browser.mjs",
    "test:enrollment": "node scripts/enrollment-smoke.mjs",
    "lint": "eslint extension/src scripts && prettier --check .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm test && npm run build && npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "playwright": "^1.56.1",
    "@types/chrome": "^0.1.30",
    "@types/node": "^22.19.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
